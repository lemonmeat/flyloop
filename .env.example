# Local settings. Copy to .env (gitignored, never committed) and fill in what you use.

# neuPrint token (neuprint.janelia.org > Account), for `python tasks.py connectome`
NEUPRINT_APPLICATION_CREDENTIALS=

# Slurm cluster, for `python tasks.py submit | status | logs | pull`.
# ssh host or alias from ~/.ssh/config (required)
# CLUSTER_HOST=mycluster
# clone of this repository on the cluster (default ~/flyloop)
# CLUSTER_REPO=~/flyloop
# where runs/ and logs/ go, e.g. a scratch file system (default: CLUSTER_REPO)
# CLUSTER_OUTPUT=/scratch/<user>/flyloop
# extra sbatch options for every job, e.g. account or partition (optional)
# CLUSTER_SBATCH_ARGS=--account=<account> --partition=<partition>
# email when jobs begin, end or fail (optional)
# CLUSTER_MAIL=you@example.edu
